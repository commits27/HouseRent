# Database configuration (MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=househunt
DATABASE_URL=mysql+pymysql://your_mysql_user:your_mysql_password@127.0.0.1:3306/househunt

# Security & Ports
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
FLASK_PORT=8081
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Admin credentials (seeded on first launch)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-development-admin-password

# Sample data toggle (1 to populate demo properties, 0 to start empty)
SEED_DATA=0
