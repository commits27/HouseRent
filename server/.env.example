# ==============================================================================
# Database Configuration (MySQL)
# ==============================================================================
# For Render / Cloud MySQL (Aiven, TiDB Cloud, PlanetScale, AWS RDS, etc.):
# Use the full connection string format:
DATABASE_URL=mysql+pymysql://your_mysql_user:your_mysql_password@your_mysql_host:3306/househunt

# Or configure individual connection variables:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=househunt

# ==============================================================================
# Security & Ports
# ==============================================================================
# Secret key used for signing authentication JWT tokens (min 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Local Flask development port (Render automatically provides $PORT)
FLASK_PORT=8081

# Allowed frontend origins for CORS (comma-separated, or * to allow all origins)
# In production on Render, set this to your Vercel domain e.g. https://househunt.vercel.app or *
FRONTEND_ORIGIN=*

# ==============================================================================
# Seed Administrator Credentials (created automatically on first launch)
# ==============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-development-admin-password

# Sample demo data toggle (1 to populate demo properties, 0 to start empty)
SEED_DATA=0
